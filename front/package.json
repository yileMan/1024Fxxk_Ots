{
  "name": "ots-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "api:generate": "cd ../backend && .\\.venv\\Scripts\\python.exe run.py export-openapi ../front/src/api/openapi.json && cd ../front && npx openapi-typescript src/api/openapi.json -o src/api/generated.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/openapi.json src/api/generated.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "naive-ui": "^2.45.0",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^2.0.0"
  }
}
