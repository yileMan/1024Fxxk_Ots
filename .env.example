# 开发环境使用 MySQL 8.x；测试必须使用不同于开发库的数据库。不要提交真实凭据。
OTS_ENV=development
OTS_DATABASE_URL=mysql+pymysql://ots_user:change-me@localhost:3306/ots_dev?charset=utf8mb4
OTS_TEST_DATABASE_URL=mysql+pymysql://ots_user:change-me@localhost:3306/ots_test?charset=utf8mb4
OTS_IMPORT_TEMP_DIR=./backend/var/imports/incoming
OTS_IMPORT_ARCHIVE_DIR=./backend/var/imports/archive
OTS_IMPORT_MAX_UPLOAD_BYTES=52428800
OTS_IMPORT_MAX_MEMBER_BYTES=52428800
OTS_IMPORT_MAX_TOTAL_BYTES=209715200
OTS_IMPORT_MAX_COMPRESSION_RATIO=100
OTS_IMPORT_MAX_CSV_ROWS=10000
OTS_IMPORT_MAX_FIELD_BYTES=65536
OTS_IMPORT_MAX_ERRORS=1000
VITE_API_BASE_URL=http://localhost:5353
# 自动化初始化管理员时临时设置；交互式执行无需此变量。
# OTS_INITIAL_ADMIN_PASSWORD=
