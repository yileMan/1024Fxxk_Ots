# 开发环境使用 MySQL 8.x；测试必须使用不同于开发库的数据库。不要提交真实凭据或签名密钥。
OTS_ENV=development
OTS_DATABASE_URL=mysql+pymysql://ots_user:change-me@localhost:3306/ots_dev?charset=utf8mb4
OTS_TEST_DATABASE_URL=mysql+pymysql://ots_user:change-me@localhost:3306/ots_test?charset=utf8mb4
VITE_API_BASE_URL=http://localhost:5353
OTS_AUTH_SECRET=replace-with-at-least-32-characters
OTS_ALLOWED_ORIGIN=http://localhost:5173
OTS_COOKIE_SECURE=false
# 自动化初始化管理员时临时设置；交互式执行无需此变量。
# OTS_INITIAL_ADMIN_PASSWORD=
